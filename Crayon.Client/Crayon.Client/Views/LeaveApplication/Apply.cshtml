@using Crayon.Client.Models
@model LeaveApplyViewModel

@{
    ViewData["Title"] = "Apply Leave";
}

<div class="page-header">
    <h2>Apply Leave</h2>
    <a asp-action="MyLeaves" class="btn btn-secondary">My Leaves</a>
</div>

@if (Model.LeaveBalances != null && Model.LeaveBalances.Any())
{
    <div class="mb-4">
        <p class="section-label">Your Leave Balances</p>
        <div class="leave-balance-strip">
            @foreach (var b in Model.LeaveBalances)
            {
                <div class="leave-balance-chip">
                    <span class="lb-name">@b.LeaveName</span>
                    <span class="lb-days">@b.AvailableDays days</span>
                </div>
            }
        </div>
    </div>
}

<div class="card">
    <div class="card-body">
        <form asp-action="Apply" method="post">

            <div asp-validation-summary="All" class="alert alert-danger py-2 mb-3"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label">Leave Type</label>
                    <select asp-for="LeaveApplication.LeaveTypeId"
                            asp-items="ViewBag.LeaveTypes"
                            class="form-select">
                        <option value="">-- Select Leave Type --</option>
                    </select>
                    <span asp-validation-for="LeaveApplication.LeaveTypeId" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label">From Date</label>
                    <input asp-for="LeaveApplication.FromDate"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="LeaveApplication.FromDate" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label">To Date</label>
                    <input asp-for="LeaveApplication.ToDate"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="LeaveApplication.ToDate" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Reason</label>
                    <textarea asp-for="LeaveApplication.Reason"
                              rows="4"
                              class="form-control"
                              placeholder="Briefly explain the reason for your leave..."></textarea>
                    <span asp-validation-for="LeaveApplication.Reason" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary px-4">Submit Application</button>
                <a asp-action="MyLeaves" class="btn btn-secondary">Cancel</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
