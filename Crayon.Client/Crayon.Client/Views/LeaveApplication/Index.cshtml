@using Crayon.Entity.Common
@using Crayon.Entity.Dto

@model Result<List<LeaveApplicationResponse>>

@{
    ViewData["Title"] = "Leave Applications";
}

<div class="page-header">
    <h2>Leave Applications</h2>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover datatable w-100">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Leave Type</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Days</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Response != null)
                {
                    foreach (var item in Model.Response)
                    {
                        <tr>
                            <td>@item.EmployeeName</td>
                            <td>@item.LeaveName</td>
                            <td>@item.FromDate.ToString("dd MMM yyyy")</td>
                            <td>@item.ToDate.ToString("dd MMM yyyy")</td>
                            <td>@item.TotalDays</td>
                            <td>
                                @if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else if (item.Status == "Cancelled")
                                {
                                    <span class="badge bg-secondary">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@item.LeaveApplicationId"
                                   class="btn btn-info btn-sm">
                                    View
                                </a>
                                @if (item.Status == "Pending")
                                {
                                    <a asp-action="Approve"
                                       asp-route-id="@item.LeaveApplicationId"
                                       class="btn btn-success btn-sm">
                                        Approve
                                    </a>
                                    <a asp-action="Reject"
                                       asp-route-id="@item.LeaveApplicationId"
                                       class="btn btn-danger btn-sm">
                                        Reject
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
