@model Crayon.Entity.Common.Result<List<Crayon.Entity.Dto.EmployeeResponse>>

@{
    ViewData["Title"] = "Employees";
}

<div class="page-header">
    <h2>Employees</h2>
    <a asp-action="Create" class="btn btn-primary">Add Employee</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover datatable w-100">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Response != null)
                {
                    foreach (var item in Model.Response)
                    {
                        <tr>
                            <td>@item.EmployeeCode</td>
                            <td>@item.FirstName @item.LastName</td>
                            <td>@item.Email</td>
                            <td>@item.DepartmentName</td>
                            <td>@item.DesignationName</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.RoleName))
                                {
                                    <span class="badge bg-secondary">@item.RoleName</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@item.EmployeeId"
                                   class="btn btn-info btn-sm">
                                    View
                                </a>
                                <a asp-action="Edit"
                                   asp-route-id="@item.EmployeeId"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>
                                <a asp-action="Delete"
                                   asp-route-id="@item.EmployeeId"
                                   class="btn btn-danger btn-sm confirm-delete"
                                   data-name="@item.FirstName @item.LastName">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model?.Error != null && Model.Error.Any())
{
    <div class="alert alert-danger mt-3">
        @Model.Error.First().ErrorMessage
    </div>
}
