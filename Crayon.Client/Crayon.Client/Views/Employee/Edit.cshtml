@model Crayon.Entity.Dto.EmployeeRequest

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="page-header">
    <h2>Edit Employee</h2>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>

<div class="card">
    <div class="card-body">

        <div asp-validation-summary="All" class="alert alert-danger py-2 mb-3"></div>

        <form asp-action="Edit"
              asp-route-id="@ViewBag.Id"
              method="post">

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">First Name</label>
                    <input asp-for="FirstName" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Last Name</label>
                    <input asp-for="LastName" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Employee Code</label>
                    <input asp-for="EmployeeCode" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Department</label>
                    <select asp-for="DepartmentId"
                            asp-items="ViewBag.Departments"
                            class="form-select">
                        <option value="">Select Department</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Designation</label>
                    <select asp-for="DesignationId"
                            asp-items="ViewBag.Designations"
                            class="form-select">
                        <option value="">Select Designation</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Workplace</label>
                    <select asp-for="WorkplaceId"
                            asp-items="ViewBag.Workplaces"
                            class="form-select">
                        <option value="">Select Workplace</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Reporting Manager</label>
                    <select asp-for="ReportingManagerId"
                            asp-items="ViewBag.Managers"
                            class="form-select">
                        <option value="">None</option>
                    </select>
                </div>

            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    Update Employee
                </button>
            </div>

        </form>

    </div>
</div>
