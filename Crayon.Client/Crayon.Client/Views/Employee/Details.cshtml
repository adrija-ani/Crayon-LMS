@model Crayon.Entity.Common.Result<Crayon.Entity.Dto.EmployeeResponse>

@{
    ViewData["Title"] = "Employee Details";
}

<div class="page-header">
    <h2>@Model.Response?.FullName</h2>
    <div>
        <a asp-action="Edit"
           asp-route-id="@Model.Response?.EmployeeId"
           class="btn btn-warning">
            Edit
        </a>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>

@if (Model?.Response != null)
{
    <div class="card">
        <div class="card-body">

            <div class="detail-row">
                <span class="detail-label">Employee Code</span>
                <span class="detail-value">@Model.Response.EmployeeCode</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Full Name</span>
                <span class="detail-value">@Model.Response.FullName</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Email</span>
                <span class="detail-value">@Model.Response.Email</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Phone</span>
                <span class="detail-value">@Model.Response.PhoneNumber</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Department</span>
                <span class="detail-value">@Model.Response.DepartmentName</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Designation</span>
                <span class="detail-value">@Model.Response.DesignationName</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Workplace</span>
                <span class="detail-value">@Model.Response.WorkplaceName</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Role</span>
                <span class="detail-value">
                    @if (!string.IsNullOrEmpty(Model.Response.RoleName))
                    {
                        <span class="badge bg-secondary">
                            @Model.Response.RoleName
                        </span>
                    }
                </span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Reporting Manager</span>
                <span class="detail-value">
                    @(string.IsNullOrEmpty(Model.Response.ReportingManagerName)
                        ? "—"
                        : Model.Response.ReportingManagerName)
                </span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Joined</span>
                <span class="detail-value">
                    @Model.Response.CreatedDate.ToString("dd MMM yyyy")
                </span>
            </div>

        </div>
    </div>
}
else
{
    <div class="alert alert-danger">
        @(Model?.Error?.FirstOrDefault()?.ErrorMessage ?? "Employee not found.")
    </div>
}
