@model Crayon.Entity.Dto.LeaveTypeRequest

<h2>Add Leave Type</h2>

<form asp-action="Create">

    <div class="mb-3">
        <label>Leave Name</label>
        <input asp-for="LeaveName"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Default Days</label>
        <input asp-for="DefaultDays"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-success">
        Save
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>