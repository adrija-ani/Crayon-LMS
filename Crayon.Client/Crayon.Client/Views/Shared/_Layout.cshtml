@using System.Linq
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Crayon HR</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    Func<string, string, string> activeClass = (controller, action) =>
    {
        var controllerMatch = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        var actionMatch = action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return controllerMatch && actionMatch ? "active" : "";
    };

    var renderedLinks = new HashSet<string>();

    Func<string, string, bool> ShouldRender = (controller, action) =>
    {
        var key = controller + "|" + action;

        if (renderedLinks.Contains(key))
            return false;

        renderedLinks.Add(key);
        return true;
    };

    var userName = User.Identity?.Name ?? "";
    var initials = "U";

    if (!string.IsNullOrWhiteSpace(userName))
    {
        var parts = userName.Split(new[] { ' ', '.', '_' }, StringSplitOptions.RemoveEmptyEntries);

        initials = parts.Length >= 2
            ? (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper()
            : userName.Substring(0, Math.Min(2, userName.Length)).ToUpper();
    }


    <div class="app-wrapper">

        <aside class="sidebar">

            <div class="sidebar-brand">
                Crayon <span>HR</span>
            </div>

            <nav class="sidebar-nav">

                <a asp-controller="Dashboard" asp-action="Index" class="@activeClass("Dashboard", "Index")">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                @{ ShouldRender("Dashboard", "Index"); }

                @* ── Administration (SystemAdmin only) ── *@
                @if (User.IsInRole("SystemAdministrator"))
                {
                    var links = new List<(string label, string icon, string controller, string action)>
                    {
                        ("Employees", "bi-people", "Employee", "Index"),
                        ("Departments", "bi-diagram-3", "Department", "Index"),
                        ("Designations", "bi-award", "Designation", "Index"),
                        ("Workplaces", "bi-building", "Workplace", "Index"),
                        ("Holidays", "bi-calendar-event", "Holiday", "Index"),
                        ("Leave Types", "bi-tags", "LeaveType", "Index"),
                        ("Leave Balances", "bi-wallet2", "LeaveBalance", "Index"),
                    };
                    var visible = links.Where(l => ShouldRender(l.controller, l.action)).ToList();
                    if (visible.Any())
                    {
                        <div class="sidebar-section"><i class="bi bi-shield-lock"></i> Administration</div>
                        foreach (var l in visible)
                        {
                            <a class="sub-link @activeClass(l.controller, l.action)" asp-controller="@l.controller" asp-action="@l.action">
                                <i class="bi @l.icon"></i> @l.label
                            </a>
                        }
                    }
                }

                @* ── HR Management ── *@
                @if (User.IsInRole("SystemAdministrator") ||
                     User.IsInRole("HRAdministrator"))
                {
                    var links = new List<(string label, string icon, string controller, string action)>
                    {
                        ("Employees", "bi-people", "Employee", "Index"),
                        ("Attendance", "bi-clock-history", "Attendance", "Index"),
                        ("Leave Applications", "bi-file-earmark-text", "LeaveApplication", "Index"),
                        ("Holidays", "bi-calendar-event", "Holiday", "Index"),
                    };
                    var visible = links.Where(l => ShouldRender(l.controller, l.action)).ToList();
                    if (visible.Any())
                    {
                        <div class="sidebar-section"><i class="bi bi-person-badge"></i> HR Management</div>
                        foreach (var l in visible)
                        {
                            <a class="sub-link @activeClass(l.controller, l.action)" asp-controller="@l.controller" asp-action="@l.action">
                                <i class="bi @l.icon"></i> @l.label
                            </a>
                        }
                    }
                }

                @* ── Team Management (Manager) ── *@
                @if (User.IsInRole("Manager") ||
                     User.IsInRole("SystemAdministrator"))
                {
                    var links = new List<(string label, string icon, string controller, string action)>
                    {
                        ("Employees", "bi-people", "Employee", "Index"),
                        ("My Team", "bi-people-fill", "Employee", "MyTeam"),
                        ("Leave Approvals", "bi-check2-square", "LeaveApplication", "Index"),
                        ("Team Attendance", "bi-calendar-check", "Attendance", "Index"),
                    };
                    var visible = links.Where(l => ShouldRender(l.controller, l.action)).ToList();
                    if (visible.Any())
                    {
                        <div class="sidebar-section"><i class="bi bi-people-fill"></i> Team</div>
                        foreach (var l in visible)
                        {
                            <a class="sub-link @activeClass(l.controller, l.action)" asp-controller="@l.controller" asp-action="@l.action">
                                <i class="bi @l.icon"></i> @l.label
                            </a>
                        }
                    }
                }

                @* ── Supervision ── *@
                @if (User.IsInRole("Supervisor") ||
                     User.IsInRole("Manager") ||
                     User.IsInRole("SystemAdministrator"))
                {
                    var links = new List<(string label, string icon, string controller, string action)>
                    {
                        ("Employees", "bi-people", "Employee", "Index"),
                        ("Attendance Monitor", "bi-eye", "Attendance", "Index"),
                        ("Task Monitor", "bi-list-check", "ProjectTask", "Index"),
                    };
                    var visible = links.Where(l => ShouldRender(l.controller, l.action)).ToList();
                    if (visible.Any())
                    {
                        <div class="sidebar-section"><i class="bi bi-eye"></i> Supervision</div>
                        foreach (var l in visible)
                        {
                            <a class="sub-link @activeClass(l.controller, l.action)" asp-controller="@l.controller" asp-action="@l.action">
                                <i class="bi @l.icon"></i> @l.label
                            </a>
                        }
                    }
                }

                @* ── Projects (privileged roles only) ── *@
                @if (User.IsInRole("SystemAdministrator") ||
                     User.IsInRole("HRAdministrator") ||
                     User.IsInRole("Manager") ||
                     User.IsInRole("Supervisor"))
                {
                    var links = new List<(string label, string icon, string controller, string action)>
                    {
                        ("Projects", "bi-kanban", "Project", "Index"),
                        ("Tasks", "bi-check2-circle", "ProjectTask", "Index"),
                        ("My Timesheets", "bi-clock", "Timesheet", "MyTimesheets"),
                    };
                    if (User.IsInRole("SystemAdministrator") ||
                        User.IsInRole("HRAdministrator") ||
                        User.IsInRole("Manager"))
                    {
                        links.Add(("All Timesheets", "bi-stopwatch", "Timesheet", "Index"));
                    }
                    var visible = links.Where(l => ShouldRender(l.controller, l.action)).ToList();
                    if (visible.Any())
                    {
                        <div class="sidebar-section"><i class="bi bi-kanban"></i> Projects</div>
                        foreach (var l in visible)
                        {
                            <a class="sub-link @activeClass(l.controller, l.action)" asp-controller="@l.controller" asp-action="@l.action">
                                <i class="bi @l.icon"></i> @l.label
                            </a>
                        }
                    }
                }

                @* ── Leave (non-admin) ── *@
                @if (!User.IsInRole("SystemAdministrator"))
                {
                    var links = new List<(string label, string icon, string controller, string action)>
                    {
                        ("Apply Leave", "bi-calendar-plus", "LeaveApplication", "Apply"),
                        ("My Leaves", "bi-calendar3", "LeaveApplication", "MyLeaves"),
                    };
                    if (!User.IsInRole("HRAdministrator") &&
                        !User.IsInRole("Manager") &&
                        !User.IsInRole("Supervisor"))
                    {
                        links.Add(("My Timesheets", "bi-clock", "Timesheet", "MyTimesheets"));
                    }
                    var visible = links.Where(l => ShouldRender(l.controller, l.action)).ToList();
                    if (visible.Any())
                    {
                        <div class="sidebar-section"><i class="bi bi-calendar3"></i> Leave</div>
                        foreach (var l in visible)
                        {
                            <a class="sub-link @activeClass(l.controller, l.action)" asp-controller="@l.controller" asp-action="@l.action">
                                <i class="bi @l.icon"></i> @l.label
                            </a>
                        }
                    }
                }

                @* ── Attendance (non-admin only) ── *@
                @if (!User.IsInRole("SystemAdministrator"))
                {
                    var links = new List<(string label, string icon, string controller, string action)>
                    {
                        ("My Attendance", "bi-clock", "Attendance", "MyAttendance"),
                    };
                    var visible = links.Where(l => ShouldRender(l.controller, l.action)).ToList();
                    if (visible.Any())
                    {
                        <div class="sidebar-section"><i class="bi bi-clock-history"></i> Attendance</div>
                        foreach (var l in visible)
                        {
                            <a class="sub-link @activeClass(l.controller, l.action)" asp-controller="@l.controller" asp-action="@l.action">
                                <i class="bi @l.icon"></i> @l.label
                            </a>
                        }
                    }
                }

            </nav>

            <div class="sidebar-user">
                <div class="s-avatar">@initials</div>
                <div class="s-meta">
                    <span class="s-name">@User.Identity!.Name</span>
                    <span class="s-role">
                        @if (User.IsInRole("SystemAdministrator")) { <text>System Admin</text> }
                        else if (User.IsInRole("HRAdministrator")) { <text>HR Admin</text> }
                        else if (User.IsInRole("Manager")) { <text>Manager</text> }
                        else if (User.IsInRole("Supervisor")) { <text>Supervisor</text> }
                        else { <text>Employee</text> }
                    </span>
                </div>
                <a class="logout" title="Sign out"
                   asp-controller="Account"
                   asp-action="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>

        </aside>

        <div class="main-wrapper">

            <header class="topbar">
                <h1 class="topbar-title">@ViewData["Title"]</h1>
            </header>

            <main class="page-content">
                @RenderBody()
            </main>

        </div>

    </div>

    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle" style="color:#DC2626;"></i>
                        Confirm Delete
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        Are you sure you want to delete <strong id="deleteConfirmName">this item</strong>?
                        This action cannot be undone.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <a href="#" id="deleteConfirmBtn" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash3"></i> Delete
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="auth-page">
        @RenderBody()
    </div>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    // Global delete-confirmation modal.
    // Any link/button with class="confirm-delete" and an href pointing to
    // the delete action will trigger this instead of the browser's native
    // confirm(). Optionally add data-name="..." to name the item being
    // deleted in the modal message (defaults to "this item").
    document.addEventListener('DOMContentLoaded', function () {
        var modalEl = document.getElementById('deleteConfirmModal');
        if (!modalEl) return;

        var modal = new bootstrap.Modal(modalEl);
        var nameEl = document.getElementById('deleteConfirmName');
        var confirmBtn = document.getElementById('deleteConfirmBtn');

        document.body.addEventListener('click', function (e) {
            var trigger = e.target.closest('.confirm-delete');
            if (!trigger) return;

            e.preventDefault();
            nameEl.textContent = trigger.getAttribute('data-name') || 'this item';
            confirmBtn.setAttribute('href', trigger.getAttribute('href'));
            modal.show();
        });
    });
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
