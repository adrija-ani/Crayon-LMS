@using Crayon.Entity.Common
@using Crayon.Entity.Dto

@model Result<List<AttendanceResponse>>

@{
    ViewData["Title"] = "My Attendance";
}

<div class="page-header">
    <h2>My Attendance</h2>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover datatable w-100">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Check In</th>
                    <th>Check Out</th>
                    <th>Hours</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Response != null)
                {
                    foreach (var item in Model.Response)
                    {
                        <tr>
                            <td>@item.AttendanceDate.ToString("dd MMM yyyy")</td>
                            <td>@item.CheckInTime</td>
                            <td>@(item.CheckOutTime.HasValue ? item.CheckOutTime.Value.ToString() : "-")</td>
                            <td>@item.HoursWorked</td>
                            <td>
                                @if (item.AttendanceStatus == "Present")
                                {
                                    <span class="badge bg-success">Present</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.AttendanceStatus</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
