@using Crayon.Entity.Common
@using Crayon.Entity.Dto
@model Result<List<AttendanceResponse>>

@{
    ViewData["Title"] = "Attendance";
}

<div class="page-header">
    <h2>All Attendance</h2>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover datatable w-100">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Date</th>
                    <th>Check In</th>
                    <th>Check Out</th>
                    <th>Hours</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Response != null)
                {
                    foreach (var item in Model.Response)
                    {
                        <tr>
                            <td>@item.EmployeeName</td>
                            <td>@item.AttendanceDate.ToString("dd MMM yyyy")</td>
                            <td>@item.CheckInTime</td>
                            <td>@(item.CheckOutTime.HasValue ? item.CheckOutTime.Value.ToString() : "—")</td>
                            <td>@item.HoursWorked</td>
                            <td>
                                @{
                                    var cls = item.AttendanceStatus == "Present" ? "bg-success" : "bg-secondary";
                                }
                                <span class="badge @cls">@item.AttendanceStatus</span>
                            </td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@item.AttendanceId"
                                   class="btn btn-info btn-sm">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
