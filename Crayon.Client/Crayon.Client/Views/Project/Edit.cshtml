@model Crayon.Entity.Dto.ProjectRequest

@{
    ViewData["Title"] = "Edit Project";
}

<h2>Edit Project</h2>

<form asp-action="Edit"
      asp-route-id="@ViewBag.Id"
      method="post">

    <div class="mb-3">

        <label class="form-label">
            Project Name
        </label>

        <input asp-for="ProjectName"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label class="form-label">
            Description
        </label>

        <textarea asp-for="Description"
                  rows="4"
                  class="form-control"></textarea>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Update
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
