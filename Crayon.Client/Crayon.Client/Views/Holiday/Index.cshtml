@model Crayon.Entity.Common.Result<List<Crayon.Entity.Dto.HolidayResponse>>

@{
    ViewData["Title"] = "Holidays";
}

<div class="page-header">
    <h2>Holidays</h2>
    @if (User.IsInRole("SystemAdministrator") || User.IsInRole("HRAdministrator"))
    {
        <a asp-action="Create" class="btn btn-primary">Add Holiday</a>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover datatable w-100">
            <thead>
                <tr>
                    <th>Holiday Name</th>
                    <th>Date</th>
                    <th>Country</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Response != null)
                {
                    foreach (var item in Model.Response)
                    {
                        <tr>
                            <td>@item.HolidayName</td>
                            <td>@item.HolidayDate.ToString("dd MMM yyyy")</td>
                            <td>@item.Country</td>
                            <td>
                                @if (User.IsInRole("SystemAdministrator") || User.IsInRole("HRAdministrator"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.HolidayId"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>
                                    <a asp-action="Delete"
                                       asp-route-id="@item.HolidayId"
                                       class="btn btn-danger btn-sm confirm-delete"
                                       data-name="@item.HolidayName">
                                        Delete
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
