@model Crayon.Entity.Dto.HolidayRequest

<h2>Edit Holiday</h2>

<form asp-action="Edit"
      asp-route-id="@ViewBag.Id"
      method="post">

    <div class="mb-3">
        <label>Holiday Name</label>
        <input asp-for="HolidayName"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Holiday Date</label>
        <input asp-for="HolidayDate"
               type="date"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Country</label>
        <input asp-for="Country"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-warning">
        Update
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>