@model Crayon.Entity.Common.Result<Crayon.Entity.Dto.HolidayResponse>

<h2>Holiday Details</h2>

@if (Model?.Response != null)
{
    <table class="table table-bordered">

        <tr>
            <th>ID</th>
            <td>@Model.Response.HolidayId</td>
        </tr>

        <tr>
            <th>Holiday Name</th>
            <td>@Model.Response.HolidayName</td>
        </tr>

        <tr>
            <th>Date</th>
            <td>@Model.Response.HolidayDate.ToString("dd-MMM-yyyy")</td>
        </tr>

        <tr>
            <th>Country</th>
            <td>@Model.Response.Country</td>
        </tr>

    </table>
}
else
{
    <div class="alert alert-danger">
        Holiday not found.
    </div>
}

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>