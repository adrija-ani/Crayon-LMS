@using Crayon.Entity.Common
@using Crayon.Entity.Dto
@model Result<WorkplaceResponse>

@{
    ViewData["Title"] = "Workplace Details";
}

<h2>Workplace Details</h2>

@if (Model != null && Model.Response != null)
{
    <table class="table table-bordered">

        <tr>
            <th width="200">ID</th>
            <td>@Model.Response.WorkplaceId</td>
        </tr>

        <tr>
            <th>Name</th>
            <td>@Model.Response.Name</td>
        </tr>

        <tr>
            <th>Address</th>
            <td>@Model.Response.Address</td>
        </tr>

    </table>

    <a asp-action="Edit"
       asp-route-id="@Model.Response.WorkplaceId"
       class="btn btn-warning">
        Edit
    </a>
}
else
{
    <div class="alert alert-danger">
        Workplace not found.
    </div>
}

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>