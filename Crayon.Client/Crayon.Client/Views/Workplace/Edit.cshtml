@model Crayon.Entity.Dto.WorkplaceRequest

<h2>Edit Workplace</h2>

<form asp-action="Edit"
      asp-route-id="@ViewBag.Id"
      method="post">

    <div class="mb-3">
        <label>Name</label>

        <input asp-for="Name"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Address</label>

        <textarea asp-for="Address"
                  class="form-control">
        </textarea>
    </div>

    <button type="submit"
            class="btn btn-warning">
        Update
    </button>

</form>