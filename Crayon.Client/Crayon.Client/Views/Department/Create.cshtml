@model Crayon.Entity.Dto.DepartmentRequest

<h2>Create Department</h2>

<form asp-action="Create"
      method="post">

    <div class="mb-3">

        <label class="form-label">
            Department Name
        </label>

        <input asp-for="DepartmentName"
               class="form-control" />

    </div>

    <button type="submit"
            class="btn btn-success">
        Save
    </button>

</form>