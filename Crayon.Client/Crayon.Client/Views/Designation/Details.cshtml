@model Crayon.Entity.Common.Result<Crayon.Entity.Dto.DesignationResponse>

@{
    ViewData["Title"] = "Designation Details";
}

<h2>Designation Details</h2>

@if (Model?.Response != null)
{
    <table class="table table-bordered">

        <tr>
            <th>ID</th>
            <td>@Model.Response.DesignationId</td>
        </tr>

        <tr>
            <th>Designation Name</th>
            <td>@Model.Response.DesignationName</td>
        </tr>

    </table>
}

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>